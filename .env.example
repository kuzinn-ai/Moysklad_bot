# Copy these names into PyCharm or hosting-provider environment settings.
# Never commit the real values in this file.
TELEGRAM_BOT_TOKEN=
MOYSKLAD_TOKEN=
TELEGRAM_USER_IDS=telegram_id_owner,telegram_id_purchaser
MINIAPP_URL=https://your-public-https-address
# Set to 1 in a local PyCharm run configuration to test read-only stock/purchase APIs from this computer.
# Leave unset on hosting; Telegram authorization remains required there.
MINIAPP_LOCAL_DEV=
# The hosting provider sets PORT automatically; local default is 8000.
# On the server, point this at a persistent disk. Docker defaults to /data/customer_orders.sqlite3.
# CUSTOMER_ORDERS_DB=/data/customer_orders.sqlite3
